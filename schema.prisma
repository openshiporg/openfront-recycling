  account          Account?     @relation("AccountDocument_account", fields: [accountId], references: [id])
  accountId        String?      @map("account")
  ticket           ScaleTicket? @relation("AccountDocument_ticket", fields: [ticketId], references: [id])
  ticketId         String?      @map("ticket")
  kind             String       @default("other")
  file_filesize    Int?
  file_filename    String?
  title            String       @default("")
  body             String       @default("")
  visibleToAccount Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  @@index([accountId])
  @@index([ticketId])
}

model ServiceSite {
  id                       String           @id @default(cuid())
  account                  Account?         @relation("ServiceSite_account", fields: [accountId], references: [id])
  accountId                String?          @map("account")
  seller                   Seller?          @relation("ServiceSite_seller", fields: [sellerId], references: [id])
  sellerId                 String?          @map("seller")
  name                     String           @default("")
  addressLine1             String           @default("")
  addressLine2             String           @default("")
  city                     String           @default("")
  region                   String           @default("")
  postalCode               String           @default("")
  country                  String           @default("US")
  contactName              String           @default("")
  contactPhone             String           @default("")
  accessNotes              String           @default("")
  latitude                 Decimal?         @postgresql.Decimal(9, 6)
  longitude                Decimal?         @postgresql.Decimal(9, 6)
  isActive                 Boolean          @default(true)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @default(now()) @updatedAt
  from_ScaleTicket_site    ScaleTicket[]    @relation("ScaleTicket_site")
  from_Container_site      Container[]      @relation("Container_site")
  from_ServiceRequest_site ServiceRequest[] @relation("ServiceRequest_site")
  from_DispatchJob_site    DispatchJob[]    @relation("DispatchJob_site")

  @@index([accountId])
  @@index([sellerId])
}

model Visit {
  id            String            @id @default(cuid())
  seller        Seller?           @relation("Visit_seller", fields: [sellerId], references: [id])
  sellerId      String?           @map("seller")
  yard          Yard?             @relation("Visit_yard", fields: [yardId], references: [id])
  yardId        String?           @map("yard")
  plannedDate   DateTime
  vehicle       Vehicle?          @relation("Visit_vehicle", fields: [vehicleId], references: [id])
  vehicleId     String?           @map("vehicle")
  expectedItems Json?
  donatePercent Int?              @default(0)
  nonprofit     Account?          @relation("Visit_nonprofit", fields: [nonprofitId], references: [id])
  nonprofitId   String?           @map("nonprofit")
  campaign      DonationCampaign? @relation("Visit_campaign", fields: [campaignId], references: [id])
  campaignId    String?           @map("campaign")
  code          String            @unique @default("")
  status        String            @default("booked")
  ticket        ScaleTicket?      @relation("ScaleTicket_visit")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt

  @@index([sellerId])
  @@index([yardId])
  @@index([vehicleId])
  @@index([nonprofitId])
  @@index([campaignId])
  @@index([status])
}

model ScaleTicket {
  id                            String              @id @default(cuid())
  yard                          Yard?               @relation("ScaleTicket_yard", fields: [yardId], references: [id])
  yardId                        String?             @map("yard")
  direction                     String              @default("inbound")
  number                        Int
  status                        String              @default("open")
  seller                        Seller?             @relation("ScaleTicket_seller", fields: [sellerId], references: [id])
  sellerId                      String?             @map("seller")
  account                       Account?            @relation("ScaleTicket_account", fields: [accountId], references: [id])
  accountId                     String?             @map("account")
  site                          ServiceSite?        @relation("ScaleTicket_site", fields: [siteId], references: [id])
  siteId                        String?             @map("site")
  vehicle                       Vehicle?            @relation("ScaleTicket_vehicle", fields: [vehicleId], references: [id])
  vehicleId                     String?             @map("vehicle")
  vehiclePlate                  String              @default("")
  vehiclePlateRegion            String              @default("")
  vehicleDescription            String              @default("")
  visit                         Visit?              @relation("ScaleTicket_visit", fields: [visitId], references: [id])
  visitId                       String?             @unique @map("visit")
  job                           DispatchJob?        @relation("ScaleTicket_job", fields: [jobId], references: [id])
  jobId                         String?             @map("job")
  container                     Container?          @relation("ScaleTicket_container", fields: [containerId], references: [id])
  containerId                   String?             @map("container")
  shipment                      Shipment?           @relation("ScaleTicket_shipment", fields: [shipmentId], references: [id])
  shipmentId                    String?             @unique @map("shipment")
  adjusts                       ScaleTicket?        @relation("ScaleTicket_adjusts", fields: [adjustsId], references: [id])
  adjustsId                     String?             @map("adjusts")
  adjustments                   ScaleTicket[]       @relation("ScaleTicket_adjusts")
  isAdjustment                  Boolean             @default(false)
  paymentMode                   String              @default("pay_now")
  lines                         TicketLine[]        @relation("TicketLine_ticket")
  weighEvents                   WeighEvent[]        @relation("WeighEvent_ticket")
  attachments                   TicketAttachment[]  @relation("TicketAttachment_ticket")
  fees                          Json?               @default("[]")
  materialTotalCents            Int                 @default(0)
  feeTotalCents                 Int                 @default(0)
  taxCents                      Int                 @default(0)
  totalCents                    Int                 @default(0)
  collectedCents                Int                 @default(0)
  donatePercent                 Int?                @default(0)
  nonprofit                     Account?            @relation("ScaleTicket_nonprofit", fields: [nonprofitId], references: [id])
  nonprofitId                   String?             @map("nonprofit")
  campaign                      DonationCampaign?   @relation("ScaleTicket_campaign", fields: [campaignId], references: [id])
  campaignId                    String?             @map("campaign")
  complianceSnapshot            Json?
  overrideReason                String              @default("")
  overrideBy                    User?               @relation("ScaleTicket_overrideBy", fields: [overrideById], references: [id])
  overrideById                  String?             @map("overrideBy")
  lookupCode                    String              @unique @default("")
  certificateRequested          Boolean             @default(false)
  openedBy                      User?               @relation("ScaleTicket_openedBy", fields: [openedById], references: [id])
  openedById                    String?             @map("openedBy")
  completedBy                   User?               @relation("ScaleTicket_completedBy", fields: [completedById], references: [id])
  completedById                 String?             @map("completedBy")
  completedAt                   DateTime?
  settledAt                     DateTime?
  voidedBy                      User?               @relation("ScaleTicket_voidedBy", fields: [voidedById], references: [id])
  voidedById                    String?             @map("voidedBy")
  voidedAt                      DateTime?
  voidReason                    String              @default("")
  payouts                       Payout[]            @relation("Payout_ticket")
  holdTags                      HoldTag[]           @relation("HoldTag_ticket")
  settlement                    Settlement?         @relation("ScaleTicket_settlement", fields: [settlementId], references: [id])
  settlementId                  String?             @map("settlement")
  notes                         String              @default("")
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @default(now()) @updatedAt
  from_AccountDocument_ticket   AccountDocument[]   @relation("AccountDocument_ticket")
  from_CashDrawerEvent_ticket   CashDrawerEvent[]   @relation("CashDrawerEvent_ticket")
  from_InventoryMovement_ticket InventoryMovement[] @relation("InventoryMovement_ticket")
  from_Invoice_ticket           Invoice[]           @relation("Invoice_ticket")
  from_PaymentSession_ticket    PaymentSession[]    @relation("PaymentSession_ticket")
  from_Donation_ticket          Donation[]          @relation("Donation_ticket")

  @@unique([yardId, direction, number], map: "ScaleTicket_yard_direction_number_key")
  @@index([yardId])
  @@index([status])
  @@index([sellerId])
  @@index([accountId])
  @@index([siteId])
  @@index([vehicleId])
  @@index([vehiclePlate])
  @@index([jobId])
  @@index([containerId])
  @@index([adjustsId])
  @@index([nonprofitId])
  @@index([campaignId])
  @@index([overrideById])
  @@index([openedById])
  @@index([completedById])
  @@index([voidedById])
  @@index([settlementId])
  @@index([status, yardId], map: "ScaleTicket_status_yard_idx")
}

model TicketLine {
  id                                String               @id @default(cuid())
  ticket                            ScaleTicket?         @relation("TicketLine_ticket", fields: [ticketId], references: [id])
  ticketId                          String?              @map("ticket")
  sortOrder                         Int?                 @default(0)
  material                          Material?            @relation("TicketLine_material", fields: [materialId], references: [id])
  materialId                        String?              @map("material")
  materialName                      String               @default("")
  direction                         String               @default("pay_seller")
  grossWeight                       Decimal              @default("0") @postgresql.Decimal(14, 2)
  tareWeight                        Decimal              @default("0") @postgresql.Decimal(14, 2)
  netWeight                         Decimal              @default("0") @postgresql.Decimal(14, 2)
  deductionWeight                   Decimal?             @postgresql.Decimal(14, 2)
  deductionPercent                  Decimal?             @postgresql.Decimal(14, 2)
  deductionReason                   String?
  payWeight                         Decimal              @default("0") @postgresql.Decimal(14, 2)
  quantity                          Int?
  unit                              String               @default("lb")
  unitPrice                         Decimal?             @postgresql.Decimal(14, 5)
  priceSource                       String?
  priceEntry                        PriceEntry?          @relation("TicketLine_priceEntry", fields: [priceEntryId], references: [id])
  priceEntryId                      String?              @map("priceEntry")
  overrideBy                        User?                @relation("TicketLine_overrideBy", fields: [overrideById], references: [id])
  overrideById                      String?              @map("overrideBy")
  overrideReason                    String               @default("")
  amountCents                       Int                  @default(0)
  restriction                       MaterialRestriction? @relation("TicketLine_restriction", fields: [restrictionId], references: [id])
  restrictionId                     String?              @map("restriction")
  documents                         Json?                @default("[]")
  payout                            Payout?              @relation("TicketLine_payout", fields: [payoutId], references: [id])
  payoutId                          String?              @map("payout")
  inventoryUnit                     InventoryUnit?       @relation("TicketLine_inventoryUnit", fields: [inventoryUnitId], references: [id])
  inventoryUnitId                   String?              @map("inventoryUnit")
  createdAt                         DateTime             @default(now())
  updatedAt                         DateTime             @default(now()) @updatedAt
  from_WeighEvent_line              WeighEvent[]         @relation("WeighEvent_line")
  from_TicketAttachment_line        TicketAttachment[]   @relation("TicketAttachment_line")
  from_InventoryMovement_ticketLine InventoryMovement[]  @relation("InventoryMovement_ticketLine")
  from_HoldTag_line                 HoldTag[]            @relation("HoldTag_line")

  @@index([ticketId])
  @@index([materialId])
  @@index([priceEntryId])
  @@index([overrideById])
  @@index([restrictionId])
  @@index([payoutId])
  @@index([inventoryUnitId])
}

model WeighEvent {
  id              String       @id @default(cuid())
  ticket          ScaleTicket? @relation("WeighEvent_ticket", fields: [ticketId], references: [id])
  ticketId        String?      @map("ticket")
  line            TicketLine?  @relation("WeighEvent_line", fields: [lineId], references: [id])
  lineId          String?      @map("line")
  scale           Scale?       @relation("WeighEvent_scale", fields: [scaleId], references: [id])
  scaleId         String?      @map("scale")
  kind            String       @default("gross")
  weight          Decimal      @default("0") @postgresql.Decimal(14, 2)
  captureMethod   String       @default("manual")
  capturedBy      User?        @relation("WeighEvent_capturedBy", fields: [capturedById], references: [id])
  capturedById    String?      @map("capturedBy")
  capturedAt      DateTime?    @default(now())
  photo_id        String?
  photo_filesize  Int?
  photo_width     Int?
  photo_height    Int?
  photo_extension String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  @@index([ticketId])
  @@index([lineId])
  @@index([scaleId])
  @@index([capturedById])
}

model TicketAttachment {
  id              String       @id @default(cuid())
  ticket          ScaleTicket? @relation("TicketAttachment_ticket", fields: [ticketId], references: [id])
  ticketId        String?      @map("ticket")
  line            TicketLine?  @relation("TicketAttachment_line", fields: [lineId], references: [id])
  lineId          String?      @map("line")
  kind            String       @default("material_photo")
  image_id        String?
  image_filesize  Int?
  image_width     Int?
  image_height    Int?
  image_extension String?
  file_filesize   Int?
  file_filename   String?
  signedName      String       @default("")
  capturedBy      User?        @relation("TicketAttachment_capturedBy", fields: [capturedById], references: [id])
  capturedById    String?      @map("capturedBy")
  capturedAt      DateTime?    @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  @@index([ticketId])
  @@index([lineId])
  @@index([capturedById])
}

model Payout {
  id                          String             @id @default(cuid())
  ticket                      ScaleTicket?       @relation("Payout_ticket", fields: [ticketId], references: [id])
  ticketId                    String?            @map("ticket")
  lines                       TicketLine[]       @relation("TicketLine_payout")
  settlement                  Settlement?        @relation("Payout_settlement", fields: [settlementId], references: [id])
  settlementId                String?            @map("settlement")
  seller                      Seller?            @relation("Payout_seller", fields: [sellerId], references: [id])
  sellerId                    String?            @map("seller")
  account                     Account?           @relation("Payout_account", fields: [accountId], references: [id])
  accountId                   String?            @map("account")
  amountCents                 Int                @default(0)
  status                      String             @default("pending")
  allowedMethods              Json?              @default("[\"cash\",\"check\",\"transfer\"]")
  method                      String?
  releaseAt                   DateTime?
  checkNumber                 String             @default("")
  bankAccountLabel            String             @default("")
  transferReference           String             @default("")
  mailToAddress               String             @default("")
  paidBy                      User?              @relation("Payout_paidBy", fields: [paidById], references: [id])
  paidById                    String?            @map("paidBy")
  paidAt                      DateTime?
  drawerSession               CashDrawerSession? @relation("Payout_drawerSession", fields: [drawerSessionId], references: [id])
  drawerSessionId             String?            @map("drawerSession")
  replaces                    Payout?            @relation("Payout_replaces", fields: [replacesId], references: [id])
  replacesId                  String?            @map("replaces")
  returnReason                String             @default("")
  cancelReason                String             @default("")
  idempotencyKeyHash          String             @unique @default("")
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @default(now()) @updatedAt
  from_Payout_replaces        Payout[]           @relation("Payout_replaces")
  from_CashDrawerEvent_payout CashDrawerEvent[]  @relation("CashDrawerEvent_payout")
  from_Settlement_payout      Settlement[]       @relation("Settlement_payout")

  @@unique([bankAccountLabel, checkNumber], map: "Payout_bank_check_key")
  @@index([ticketId])
  @@index([settlementId])
  @@index([sellerId])
  @@index([accountId])
  @@index([status])
  @@index([paidById])
  @@index([drawerSessionId])
  @@index([replacesId])
  @@index([status, releaseAt], map: "Payout_status_release_idx")
}

model CashDrawer {
  id        String              @id @default(cuid())
  yard      Yard?               @relation("CashDrawer_yard", fields: [yardId], references: [id])
  yardId    String?             @map("yard")
  name      String              @default("")
  isActive  Boolean             @default(true)
  sessions  CashDrawerSession[] @relation("CashDrawerSession_drawer")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @default(now()) @updatedAt

  @@index([yardId])
}

model CashDrawerSession {
  id                        String            @id @default(cuid())
  drawer                    CashDrawer?       @relation("CashDrawerSession_drawer", fields: [drawerId], references: [id])
  drawerId                  String?           @map("drawer")
  cashier                   User?             @relation("CashDrawerSession_cashier", fields: [cashierId], references: [id])
  cashierId                 String?           @map("cashier")
  status                    String            @default("open")
  openingFloatCents         Int               @default(0)
  expectedCents             Int               @default(0)
  countedCents              Int?
  varianceCents             Int?
  openedAt                  DateTime?         @default(now())
  closedAt                  DateTime?
  approvedBy                User?             @relation("CashDrawerSession_approvedBy", fields: [approvedById], references: [id])
  approvedById              String?           @map("approvedBy")
  approvalNote              String            @default("")
  events                    CashDrawerEvent[] @relation("CashDrawerEvent_session")
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @default(now()) @updatedAt
  from_Payout_drawerSession Payout[]          @relation("Payout_drawerSession")

  @@index([drawerId])
  @@index([cashierId])
  @@index([status])
  @@index([approvedById])
}

model CashDrawerEvent {
  id           String             @id @default(cuid())
  session      CashDrawerSession? @relation("CashDrawerEvent_session", fields: [sessionId], references: [id])
  sessionId    String?            @map("session")
  kind         String             @default("add")
  amountCents  Int                @default(0)
  payout       Payout?            @relation("CashDrawerEvent_payout", fields: [payoutId], references: [id])
  payoutId     String?            @map("payout")
  ticket       ScaleTicket?       @relation("CashDrawerEvent_ticket", fields: [ticketId], references: [id])
  ticketId     String?            @map("ticket")
  note         String             @default("")
  referenceKey String             @unique @default("")
  createdBy    User?              @relation("CashDrawerEvent_createdBy", fields: [createdById], references: [id])
  createdById  String?            @map("createdBy")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt

  @@index([sessionId])
  @@index([payoutId])
  @@index([ticketId])
  @@index([createdById])
}

model AccountCharge {
  id            String       @id @default(cuid())
  account       Account?     @relation("AccountCharge_account", fields: [accountId], references: [id])
  accountId     String?      @map("account")
  kind          String       @default("other")
  description   String       @default("")
  amountCents   Int          @default(0)
  job           DispatchJob? @relation("AccountCharge_job", fields: [jobId], references: [id])
  jobId         String?      @map("job")
  container     Container?   @relation("AccountCharge_container", fields: [containerId], references: [id])
  containerId   String?      @map("container")
  serviceDate   DateTime?
  referenceKey  String       @unique @default("")
  settlement    Settlement?  @relation("AccountCharge_settlement", fields: [settlementId], references: [id])
  settlementId  String?      @map("settlement")
  invoiceLine   InvoiceLine? @relation("AccountCharge_invoiceLine", fields: [invoiceLineId], references: [id])
  invoiceLineId String?      @map("invoiceLine")
  status        String       @default("open")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  @@index([accountId])
  @@index([jobId])
  @@index([containerId])
  @@index([settlementId])
  @@index([invoiceLineId])
  @@index([status])
}

model Settlement {
  id                      String          @id @default(cuid())
  account                 Account?        @relation("Settlement_account", fields: [accountId], references: [id])
  accountId               String?         @map("account")
  number                  Int?
  status                  String          @default("draft")
  periodStart             DateTime?
  periodEnd               DateTime?
  tickets                 ScaleTicket[]   @relation("ScaleTicket_settlement")
  charges                 AccountCharge[] @relation("AccountCharge_settlement")
  donations               Donation[]      @relation("Donation_settlement")
  ticketTotalCents        Int             @default(0)
  chargeTotalCents        Int             @default(0)
  donationTotalCents      Int             @default(0)
  netCents                Int             @default(0)
  payout                  Payout?         @relation("Settlement_payout", fields: [payoutId], references: [id])
  payoutId                String?         @map("payout")
  invoice                 Invoice?        @relation("Settlement_invoice", fields: [invoiceId], references: [id])
  invoiceId               String?         @map("invoice")
  approvedBy              User?           @relation("Settlement_approvedBy", fields: [approvedById], references: [id])
  approvedById            String?         @map("approvedBy")
  approvedAt              DateTime?
  paidAt                  DateTime?
  voidReason              String          @default("")
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @default(now()) @updatedAt
  from_Payout_settlement  Payout[]        @relation("Payout_settlement")
  from_Invoice_settlement Invoice[]       @relation("Invoice_settlement")

  @@unique([number], map: "Settlement_number_key")
  @@index([accountId])
  @@index([status])
  @@index([payoutId])
  @@index([invoiceId])
  @@index([approvedById])
}

model InventoryBalance {
  id             String    @id @default(cuid())
  yard           Yard?     @relation("InventoryBalance_yard", fields: [yardId], references: [id])
  yardId         String?   @map("yard")
  material       Material? @relation("InventoryBalance_material", fields: [materialId], references: [id])
  materialId     String?   @map("material")
  onHandWeight   Decimal   @default("0") @postgresql.Decimal(14, 2)
  reservedWeight Decimal   @default("0") @postgresql.Decimal(14, 2)
  heldWeight     Decimal   @default("0") @postgresql.Decimal(14, 2)
  totalCostCents Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([yardId, materialId], map: "InventoryBalance_yard_material_key")
  @@index([yardId])
  @@index([materialId])
}

model InventoryMovement {
  id              String         @id @default(cuid())
  yard            Yard?          @relation("InventoryMovement_yard", fields: [yardId], references: [id])
  yardId          String?        @map("yard")
  material        Material?      @relation("InventoryMovement_material", fields: [materialId], references: [id])
  materialId      String?        @map("material")
  kind            String         @default("receive")
  weightDelta     Decimal        @default("0") @postgresql.Decimal(14, 2)
  costDeltaCents  Int            @default(0)
  weightAfter     Decimal        @default("0") @postgresql.Decimal(14, 2)
  ticket          ScaleTicket?   @relation("InventoryMovement_ticket", fields: [ticketId], references: [id])
  ticketId        String?        @map("ticket")
  ticketLine      TicketLine?    @relation("InventoryMovement_ticketLine", fields: [ticketLineId], references: [id])
  ticketLineId    String?        @map("ticketLine")
  processingRun   ProcessingRun? @relation("InventoryMovement_processingRun", fields: [processingRunId], references: [id])
  processingRunId String?        @map("processingRun")
  transfer        YardTransfer?  @relation("InventoryMovement_transfer", fields: [transferId], references: [id])
  transferId      String?        @map("transfer")
  unit            InventoryUnit? @relation("InventoryMovement_unit", fields: [unitId], references: [id])
  unitId          String?        @map("unit")
  reason          String         @default("")
  needsReview     Boolean        @default(false)
  reviewedBy      User?          @relation("InventoryMovement_reviewedBy", fields: [reviewedById], references: [id])
  reviewedById    String?        @map("reviewedBy")
  reviewedAt      DateTime?
  referenceKey    String         @unique @default("")
  occurredAt      DateTime?      @default(now())
  createdBy       User?          @relation("InventoryMovement_createdBy", fields: [createdById], references: [id])
  createdById     String?        @map("createdBy")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  @@index([yardId])
  @@index([materialId])
  @@index([ticketId])
  @@index([ticketLineId])
  @@index([processingRunId])
  @@index([transferId])
  @@index([unitId])
  @@index([reviewedById])
  @@index([createdById])
}

model InventoryUnit {
  id                            String              @id @default(cuid())
  yard                          Yard?               @relation("InventoryUnit_yard", fields: [yardId], references: [id])
  yardId                        String?             @map("yard")
  tagNumber                     String              @default("")
  material                      Material?           @relation("InventoryUnit_material", fields: [materialId], references: [id])
  materialId                    String?             @map("material")
  form                          String              @default("bale")
  weight                        Decimal             @default("0") @postgresql.Decimal(14, 2)
  location                      String              @default("")
  status                        String              @default("available")
  costCents                     Int                 @default(0)
  shipment                      Shipment?           @relation("InventoryUnit_shipment", fields: [shipmentId], references: [id])
  shipmentId                    String?             @map("shipment")
  listing                       Listing?            @relation("InventoryUnit_listing", fields: [listingId], references: [id])
  listingId                     String?             @map("listing")
  transfer                      YardTransfer?       @relation("InventoryUnit_transfer", fields: [transferId], references: [id])
  transferId                    String?             @map("transfer")
  photo_id                      String?
  photo_filesize                Int?
  photo_width                   Int?
  photo_height                  Int?
  photo_extension               String?
  createdFromRun                ProcessingRun?      @relation("InventoryUnit_createdFromRun", fields: [createdFromRunId], references: [id])
  createdFromRunId              String?             @map("createdFromRun")

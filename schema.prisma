  pickContainer          Container?      @relation("DispatchJob_pickContainer", fields: [pickContainerId], references: [id])
  pickContainerId        String?         @map("pickContainer")
  site                   ServiceSite?    @relation("DispatchJob_site", fields: [siteId], references: [id])
  siteId                 String?         @map("site")
  startedAt              DateTime?
  arrivedAt              DateTime?
  completedAt            DateTime?
  photos                 Json?           @default("[]")
  signedName             String          @default("")
  failureReason          String          @default("")
  driverNotes            String          @default("")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt
  from_ScaleTicket_job   ScaleTicket[]   @relation("ScaleTicket_job")
  from_AccountCharge_job AccountCharge[] @relation("AccountCharge_job")
  from_Shipment_job      Shipment[]      @relation("Shipment_job")

  @@unique([number], map: "DispatchJob_number_key")
  @@index([yardId])
  @@index([shipmentId])
  @@index([status])
  @@index([driverId])
  @@index([truckId])
  @@index([dropContainerId])
  @@index([pickContainerId])
  @@index([siteId])
}

model DonationCampaign {
  id                        String        @id @default(cuid())
  account                   Account?      @relation("DonationCampaign_account", fields: [accountId], references: [id])
  accountId                 String?       @map("account")
  name                      String        @default("")
  slug                      String        @unique @default("")
  description               String        @default("")
  image_id                  String?
  image_filesize            Int?
  image_width               Int?
  image_height              Int?
  image_extension           String?
  goalWeight                Decimal?      @postgresql.Decimal(14, 2)
  goalCents                 Int?
  startsOn                  DateTime?
  endsOn                    DateTime?
  isPublic                  Boolean       @default(true)
  status                    String        @default("draft")
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @default(now()) @updatedAt
  from_Visit_campaign       Visit[]       @relation("Visit_campaign")
  from_ScaleTicket_campaign ScaleTicket[] @relation("ScaleTicket_campaign")
  from_Donation_campaign    Donation[]    @relation("Donation_campaign")

  @@index([accountId])
}

model Donation {
  id                      String            @id @default(cuid())
  ticket                  ScaleTicket?      @relation("Donation_ticket", fields: [ticketId], references: [id])
  ticketId                String?           @map("ticket")
  seller                  Seller?           @relation("Donation_seller", fields: [sellerId], references: [id])
  sellerId                String?           @map("seller")
  account                 Account?          @relation("Donation_account", fields: [accountId], references: [id])
  accountId               String?           @map("account")
  campaign                DonationCampaign? @relation("Donation_campaign", fields: [campaignId], references: [id])
  campaignId              String?           @map("campaign")
  amountCents             Int               @default(0)
  weight                  Decimal?          @postgresql.Decimal(14, 2)
  itemsSummary            Json?             @default("[]")
  kind                    String            @default("payout_donation")
  status                  String            @default("pledged")
  receiptNumber           String            @unique @default("")
  receiptIssuedAt         DateTime?
  goodsOrServicesProvided Boolean           @default(false)
  showDonorName           Boolean           @default(false)
  settlement              Settlement?       @relation("Donation_settlement", fields: [settlementId], references: [id])
  settlementId            String?           @map("settlement")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @default(now()) @updatedAt

  @@index([ticketId])
  @@index([sellerId])
  @@index([accountId])
  @@index([campaignId])
  @@index([status])
  @@index([settlementId])
}

model RulesProfile {
  id                      String                @id @default(cuid())
  name                    String                @default("")
  region                  String                @default("")
  template                String                @default("general")
  requireGovernmentId     Boolean               @default(true)
  requireIdPhoto          Boolean               @default(true)
  requireSellerPhoto      Boolean               @default(false)
  requireMaterialPhoto    Boolean               @default(true)
  requireVehiclePlate     Boolean               @default(true)
  requireSignature        Boolean               @default(true)
  requireThumbprint       Boolean               @default(false)
  minimumSellerAge        Int                   @default(18)
  cashLimitPerTicketCents Int?
  cashLimitPerDayCents    Int?
  cashRounding            String                @default("none")
  defaultPaymentHoldDays  Int                   @default(0)
  defaultMaterialHoldDays Int                   @default(0)
  allowEarlyRelease       Boolean               @default(false)
  retentionDays           Int                   @default(730)
  dailyReport             Boolean               @default(false)
  reportDueTime           String                @default("")
  reportOmitsPrice        Boolean               @default(false)
  ownershipStatement      String                @default("I am the lawful owner of the material sold on this ticket, or I am authorised by the owner to sell it.")
  restrictions            MaterialRestriction[] @relation("MaterialRestriction_profile")
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt
  from_Yard_rulesProfile  Yard[]                @relation("Yard_rulesProfile")
}

model MaterialRestriction {
  id                          String            @id @default(cuid())
  profile                     RulesProfile?     @relation("MaterialRestriction_profile", fields: [profileId], references: [id])
  profileId                   String?           @map("profile")
  material                    Material?         @relation("MaterialRestriction_material", fields: [materialId], references: [id])
  materialId                  String?           @map("material")
  category                    MaterialCategory? @relation("MaterialRestriction_category", fields: [categoryId], references: [id])
  categoryId                  String?           @map("category")
  label                       String            @default("")
  kind                        String            @default("payment_rule")
  requiredDocuments           Json?             @default("[]")
  forbidCash                  Boolean           @default(false)
  allowedMethods              Json?
  paymentHoldDays             Int?              @default(0)
  materialHoldDays            Int?              @default(0)
  mailCheckOnly               Boolean           @default(false)
  publicNote                  String            @default("")
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @default(now()) @updatedAt
  from_TicketLine_restriction TicketLine[]      @relation("TicketLine_restriction")

  @@index([profileId])
  @@index([materialId])
  @@index([categoryId])
}

model HoldTag {
  id            String       @id @default(cuid())

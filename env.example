# Required
DATABASE_URL=postgresql://user:password@localhost:5432/openfront_recycling
SESSION_SECRET=replace-with-at-least-32-random-characters

# Card payments (Stripe). Cash, check, transfer and recorded wire payments work without these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (password reset, notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional S3-compatible storage for photos and ID images; files are stored locally without it.
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Public URL used in email links and payment returns
PUBLIC_BASE_URL=http://localhost:3000
